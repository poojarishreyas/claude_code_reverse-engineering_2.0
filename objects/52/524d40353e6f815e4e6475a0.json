          "command": "sed -E 's/((api[_-]?key|token|secret|authorization)[^:]*:[[:space:]]*).+/\\1<masked>/I; s/(sk-|eyJ)[A-Za-z0-9._-]{8,}/<masked>/g' ~/.dsh/settings.yaml | grep -n -i -B3 -A25 \"omniroute\" | head -80; echo ====; grep -n -i \"omniroute\" ~/.dsh/.credentials.yaml | sed -E 's/:[[:space:]]*[^[:space:]].*$/: <present, masked>/' | head",
